@page
@model PlansModel
@{
    ViewData["Title"] = "Plans";
}

<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>

<div class="container">
    <h2>Subscription Plans</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="text-danger">@Model.ErrorMessage</div>
    }

    @if (Model.CurrentSubscription != null)
    {
        <p>
            You already have a subscription on <strong>@Model.CurrentSubscription.ProductName</strong>
            (state: @Model.CurrentSubscription.State).
            <a asp-page="Mine">View my subscription</a>
        </p>
    }
    else
    {
        <div class="row">
            @foreach (var plan in Model.Plans)
            {
                <div class="col-xs-4">
                    <article class="esh-catalog-items row">
                        <h3>@plan.Name</h3>
                        <p>$ @plan.Price.ToString("N2") / @plan.IntervalUnit</p>
                        <form method="post" asp-page-handler="Subscribe">
                            <input type="hidden" name="productHandle" value="@plan.Handle" />
                            <button type="submit" class="btn esh-basket-checkout">[ Subscribe ]</button>
                        </form>
                    </article>
                </div>
            }
        </div>
    }
</div>
